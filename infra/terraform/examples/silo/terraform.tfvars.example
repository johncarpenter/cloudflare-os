account_id    = "0123456789abcdef0123456789abcdef"
instance_name = "bank"
# See examples/pool/terraform.tfvars.example: use ../../../release-out from a copy at infra/terraform/live-<name>.
release_dir   = "../../../../release-out"

hostname  = "bank.example.com"
zone_name = "example.com"

clerk_issuer          = "https://example.clerk.accounts.dev"
clerk_publishable_key = "pk_live_..."

# Clerk user ids of the deployment operators (who can open /admin).
operators = ["user_2abc..."]

# The Clerk organization this instance is dedicated to.
tenant_organization_id = "org_2abc..."

# Optional integrations beyond the context library and the scheduler:
# gatekeepers = { github = {} }

# AI Gateway. Every request is tagged with its client (the user's tenant); default_client tags users
# that belong to no tenant. Use a different name per silo to get separate analytics and spend limits.
# ai_gateway = { enabled = true, name = "default", default_client = "unassigned" }

# Secrets do not belong in this file. Supply them from the environment instead:
#   export TF_VAR_clerk_webhook_secret='whsec_...'
#   export TF_VAR_gatekeeper_secrets='{"github":{"CLIENT_ID":"...","CLIENT_SECRET":"..."}}'
