# Dependencies
node_modules/

# Build outputs
dist/
# Generated gatekeeper UI bundles, rebuilt as a prerequisite of build/deploy
packages/gatekeeper-*/src/generated/*-configurator-ui.txt
packages/gatekeeper-*/src/generated/*-configurator-ui.js*
packages/gatekeeper-*/src/generated/app.txt
# Bundled blueprints (regenerated at build time from BUNDLED_BLUEPRINTS_DIR).
packages/workshop-backend/src/generated/bundled-blueprints.ts
packages/workshop-backend/src/generated/browser-export-runtime.txt
packages/workshop-backend/src/generated/html-sanitizer-runtime.txt
packages/workshop-backend/src/generated/browser-export-page.js

# TypeScript build info
*.tsbuildinfo

# run-local build cache stamp
.run-local-stamp

# Cloudflare Workers
.wrangler
.env

# Local dev secrets (loaded by run-dev-server.ts)
.dev.vars*

# Site-specific deployment configs.
wrangler.prod.jsonc
wrangler.staging.jsonc

# Site-specific dev server configs.
wrangler.dev.jsonc

# Scratch output from scripts/preview (the PR-preview comment body).
/output/

# macOS
.DS_Store

# Wrangler local dev secrets (never commit). Matches root and per-package .dev.vars files.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# Terraform: provider downloads and local state. Example roots commit their .terraform.lock.hcl; the
# module's own lock file is only a test artifact. State and variable files can hold secrets.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
infra/terraform/modules/**/.terraform.lock.hcl
# A release prepared for Terraform (verify-release.ts --materialize); the test fixtures keep theirs.
release-out/

# A saved Terraform plan holds the values it would apply, secrets included.
*.tfplan
